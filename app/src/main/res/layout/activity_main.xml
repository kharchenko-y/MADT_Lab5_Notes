<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_heading"
        android:textColor="@color/ink"
        android:textSize="31sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/app_subtitle"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/storage_label"
        android:letterSpacing="0.09"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/storageSpinner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="5dp"
        android:paddingStart="12dp"
        android:paddingEnd="10dp" />

    <TextView
        android:id="@+id/storageExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/sqlite_description"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addNoteButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="9dp"
            android:background="@drawable/primary_button_bg"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/new_note"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="15sp" />

        <Button
            android:id="@+id/syncButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="0.74"
            android:background="@drawable/secondary_button_bg"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/sync_button"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notes_label"
            android:letterSpacing="0.09"
            android:textColor="@color/muted"
            android:textStyle="bold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/noteCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_notes"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">
        <ListView
            android:id="@+id/notesList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:clipToPadding="false"
            android:paddingBottom="14dp"
            android:scrollbars="vertical" />
        <TextView
            android:id="@+id/emptyNotes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/empty_notes"
            android:textAlignment="center"
            android:textColor="@color/muted"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
